{
  "info": {
    "name": "Task Management System API",
    "description": "Dokumentasi API lengkap standar industri untuk Task Management System (Technical Assessment). Termasuk autokofigurasi JWT Bearer token via skrip uji Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "description": "Endpoint publik untuk autentikasi dan registrasi",
      "item": [
        {
          "name": "1.1. Login (Admin / User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"JWT Token otomatis disimpan ke variabel koleksi: 'jwt_token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@taskmanager.com\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Mengautentikasi pengguna. Token JWT yang dihasilkan akan **otomatis disimpan** oleh skrip Postman ke variabel `{{jwt_token}}` untuk semua request selanjutnya."
          }
        },
        {
          "name": "1.2. Register New User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Jane Doe\",\n    \"email\": \"jane.doe@taskmanager.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan pengguna baru (Secara default akan diberikan role ROLE_USER)."
          }
        },
        {
          "name": "1.3. Get All Users (Dropdown Assignment)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "users"
              ]
            },
            "description": "Mendapatkan daftar seluruh pengguna (Biasa dipakai untuk dropdown di Form Create Task)."
          }
        }
      ]
    },
    {
      "name": "2. Task Management",
      "description": "Operasi CRUD untuk entitas Tasks",
      "item": [
        {
          "name": "2.1. Get All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Mendapatkan daftar tugas. Admin akan melihat seluruh tugas, sedangkan User hanya melihat tugas yang ditugaskan kepadanya."
          }
        },
        {
          "name": "2.2. Search & Filter Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks?search=Laporan&status=TODO",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Laporan",
                  "description": "Kata kunci pencarian di kolom Judul"
                },
                {
                  "key": "status",
                  "value": "TODO",
                  "description": "Filter status: TODO, IN_PROGRESS, DONE"
                }
              ]
            },
            "description": "Contoh penggunaan Query Parameter untuk memfilter list tugas."
          }
        },
        {
          "name": "2.3. Get Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Mendapatkan detail satu tugas spesifik."
          }
        },
        {
          "name": "2.4. Create New Task (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Membuat Laporan Bulanan\",\n    \"description\": \"Tolong buatkan laporan keuangan bulanan bulan ini dan submit besok pagi.\",\n    \"status\": \"TODO\",\n    \"assignedToId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Membuat tugas baru. **Membutuhkan ROLE_ADMIN**."
          }
        },
        {
          "name": "2.5. Update Full Task (ADMIN Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Membuat Laporan Bulanan (Revisi)\",\n    \"description\": \"Tolong buatkan laporan keuangan bulanan dengan data terbaru bulan ini.\",\n    \"status\": \"IN_PROGRESS\",\n    \"assignedToId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Memperbarui isi tugas secara keseluruhan. **Membutuhkan ROLE_ADMIN**."
          }
        },
        {
          "name": "2.6. Update Task Status (Admin/User)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"DONE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/1/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "1",
                "status"
              ]
            },
            "description": "Hanya memperbarui status tugas (contoh kasus dari UI ketika memindah dropdown status/kanban)."
          }
        },
        {
          "name": "2.7. Delete Task (ADMIN Only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tasks/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Menghapus tugas. **Membutuhkan ROLE_ADMIN**."
          }
        }
      ]
    }
  ]
}
